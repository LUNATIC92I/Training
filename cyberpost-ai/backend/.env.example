# ============================================================================
# CyberPost AI : configuration du backend (copier en .env, ne jamais committer)
# ============================================================================
APP_NAME="CyberPost AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://cyberpost.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Adresses IP des proxys inverses de confiance (ex. Nginx local) pour détecter HTTPS
TRUSTED_PROXIES=127.0.0.1

LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyberpost
DB_USERNAME=cyberpost
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12

# --- Planification -----------------------------------------------------------
CYBERPOST_TIMEZONE=Africa/Abidjan
CYBERPOST_APP_DEEP_LINK=cyberpost://linkedin
# Simulation de l'heure (--now) : réservée aux tests, toujours false en production
CYBERPOST_ALLOW_TIME_TRAVEL=false

# --- LinkedIn (voir docs/LINKEDIN.md) ----------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://cyberpost.example.com/linkedin/callback
LINKEDIN_SCOPES="openid profile w_member_social"
# Version AAAAMM de l'API Posts ; à mettre à jour avant son retrait (au moins 1 an de support)
LINKEDIN_API_VERSION=202610

# --- Génération de contenu (voir docs/GENERATION.md) -------------------------
LLM_PROVIDER=anthropic
LLM_TIMEOUT=120
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
CUSTOM_LLM_NAME="Fournisseur compatible OpenAI"
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_BASE_URL=
NEWS_SOURCES_ENABLED=true

# --- Notifications push Firebase (facultatif, voir docs/NOTIFICATIONS.md) ----
FCM_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=
FCM_ANDROID_APP_ID=
FCM_ANDROID_API_KEY=
FCM_SENDER_ID=
